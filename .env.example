# Copy to .env and fill in. NEVER commit the real .env — it is in .gitignore.
# Load it with:  set -a && source .env && set +a

# Exchange API credentials. Create keys with TRADING permission only —
# never enable withdrawals on a key used by a bot.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Only some venues (e.g. Coinbase, KuCoin, OKX) use a passphrase.
EXCHANGE_API_PASSWORD=

# Optional: a Slack-compatible incoming webhook for trade notifications.
TRADINGBOT_WEBHOOK_URL=

# Free block-explorer API key, for `tradingbot research`. One key covers every
# supported chain. Get one at https://etherscan.io/apis
ETHERSCAN_API_KEY=
